# =============================================================
# Supply Chain Platform — Environment Variables
# .env.example  |  Section 5-B
# =============================================================
# Copy this file to .env and fill in your own values before
# running `docker compose up`.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# =============================================================

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=supplychain_db
POSTGRES_USER=scadmin
POSTGRES_PASSWORD=changeme_in_production   # ← CHANGE THIS
POSTGRES_PORT=5432

# ── API ────────────────────────────────────────────────────
# Comma-separated list of valid API keys
SUPPLYCHAIN_API_KEYS=dev-local-key-12345,demo-key-supplychain
API_PORT=8000

# ── Streamlit ─────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── MLflow ────────────────────────────────────────────────
MLFLOW_PORT=5000
